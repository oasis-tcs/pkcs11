#define CKM_COMP_SIG_EXTERNAL_HASH      TBD
#define CKM_COMP_KEM_KEY_PAIR_GEN	TBD
#define CKM_COMP_KEM 		        TBD

New Comp KEM Params
#define CKP_COMP_KEM_MLKEM768_RSA2048               0x00000001
#define CKP_COMP_KEM_MLKEM768_RSA3072               0x00000002
#define CKP_COMP_KEM_MLKEM768_RSA4096               0x00000003
