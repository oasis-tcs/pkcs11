#define CKP_COMP_KEM_MLKEM1024_ECDH_P384            0x00000009
#define CKP_COMP_KEM_MLKEM1024_ECDH_BRAINPOOLP384R1 0x0000000a
#define CKP_COMP_KEM_MLKEM1024_X448                 0x0000000b
#define CKP_COMP_KEM_MLKEM1024_ECDH_P521            0x0000000c

